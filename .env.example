# Copie para .env e preencha. O .env esta no .gitignore e nunca deve ser comitado.
# Estas variaveis sao lidas pelo .mcp.json.

# Trello — credenciais em https://trello.com/app-key
# TRELLO_API_KEY e a chave. TRELLO_TOKEN e gerado a partir dela, no link "Token".
TRELLO_API_KEY=
TRELLO_TOKEN=
# Opcional. Sem workspace, o servidor exige o id do quadro em cada chamada.
TRELLO_WORKSPACE_ID=

# GitHub — token de acesso pessoal fino (fine-grained), em
# https://github.com/settings/personal-access-tokens
# Conceda apenas o repositorio deste projeto, e apenas os escopos que voce for usar.
GITHUB_PAT=
